# NEXUS — local environment (copy to .env.local and fill in)
# .env.local is git-ignored; this example is safe to commit.

# ── Autonomous agent sandbox (local development only) ──────────────────
# Convenience for `npm run dev` so you don't have to paste the key in the UI.
# Ignored when NODE_ENV=production: a deployment must not pay for strangers'
# sandbox runs, so there users bring their own key via Settings → API Keys.
# Use the "API Key" (e2b_...), NOT an access token.
# Get it at https://e2b.dev  → Dashboard → API Keys
E2B_API_KEY=

# ── Model providers ────────────────────────────────────────────────────
# You can also paste these directly in Settings instead of here.
# OpenRouter (100+ models): https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...
# NVIDIA NIM: https://build.nvidia.com
# NVIDIA_API_KEY=nvapi-...

# ── Optional: self-hosted API server (npm run api) ─────────────────────
# Required when NODE_ENV=production — the server refuses to start without it
# rather than leaving every /v1 route open to anonymous callers.
# NEXUS_API_KEY=
# PORT=7860
